# Auth0 application settings. Never commit real values.
AUTH0_SECRET=replace-with-a-long-random-secret
AUTH0_BASE_URL=http://localhost:3000
AUTH0_CLIENT_ID=replace-with-auth0-client-id
AUTH0_ISSUER_BASE_URL=https://replace-with-your-auth0-domain

# Vercel supplies the port; set AUTH0_BASE_URL to the deployed URL in Vercel.
# PORT=3000
